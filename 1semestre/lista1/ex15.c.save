//Exercício 15: Calculo de área do triangulo

#include <stdio.h>
#include <math.h>

int main ()
{
	double L1, L2, L3, T, A, B, C, D;
	A = 2;

//entrada dos lados do triângulo

	printf("digite o valor do primeiro lado do triângulo:\n");
	scanf("%lf", &L1);

	printf("digite o valor do segundo lado do triângulo:\n");
	scanf("%lf", &L2);

	printf("digite o valor do terceir lado do triângulo:\n");
	scanf("%lf", &L3);

//processamento

	B = L1 + L2 + L3;
	T = B/A;
	C = T*((T-L1)*(T-L2)*(T-L3));
	D = sqrt (C);

//resultado

if (L1 < 0 || L2 < 0 || L3 <0)

{
	printf("erro, valores inseridos inválidos! (valores<0)\n");
}

else

{
	printf("---RESULTADO---\n");
	printf("valores inseridos: %.2lf, %.2lf, %.2lf\n", L1, L2, L3);
	printf("área do triângulo inserido: %lf\n", D);
}

return 0;

}



